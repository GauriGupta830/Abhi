# ── Groq API keys (ek ya zyada — multiple keys = automatic rotation/fallback) ──
GROQ_API_KEY_1=gsk_your_groq_key_here
# GROQ_API_KEY_2=gsk_optional_second_key
# GROQ_API_KEY=legacy_single_key_also_works

# ── HuggingFace token (FREE) — embeddings ke liye ──
# Python version mein sentence-transformers/all-MiniLM-L6-v2 model locally
# chalta tha. PHP mein wahi model HuggingFace Inference API se use hota hai,
# jiske liye ek free token chahiye: https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_your_token_here

# ── Optional: apna embedding server (e.g. text-embeddings-inference) ──
# Default: https://api-inference.huggingface.co/models/sentence-transformers/all-MiniLM-L6-v2
# EMBEDDINGS_API_URL=http://127.0.0.1:8080
